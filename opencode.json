{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "plugin": [
    "@warp-dot-dev/opencode-warp"
  ],
  "instructions": [
    "rules/testing.md",
    "rules/**/*.md"
  ],
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.password-store/**": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.netrc": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf ~": "deny",
      "rm -rf $HOME/*": "deny",
      "rm -rf $HOME": "deny",
      "rm -rf /": "deny",
      "rm -rf ~/.config/*": "deny",
      "rm -rf $HOME/.config/*": "deny",
      "sudo *": "deny",
      "doas *": "deny",
      "diskutil *": "deny",
      "chmod 777*": "deny",
      "chmod -R 777*": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny",
      "* | sudo *": "deny",
      "* |sudo *": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push -f*": "deny",
      "git push --force *": "deny",
      "git push --force": "deny",
      "git push * --force": "deny",
      "git push * --force *": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git clean -f *": "deny",
      "git branch *": "deny",
      "git checkout .": "deny",
      "git checkout -- *": "deny",
      "git restore .": "deny",
      "git restore *": "deny",
      "git rm *": "deny",
      "git switch *": "deny",
      "git checkout develop": "deny",
      "git checkout main": "deny",
      "git checkout master": "deny",
      "git checkout -b *": "deny",
      "git checkout -B *": "deny",
      "git switch -c *": "deny",
      "git switch -C *": "deny",
      "git stash drop *": "deny",
      "git stash clear": "deny",
      "* > ~/.config/opencode*": "deny",
      "* >> ~/.config/opencode*": "deny",
      "tee ~/.config/opencode*": "deny",
      "tee -a ~/.config/opencode*": "deny",
      "cp * ~/.config/opencode*": "deny",
      "mv * ~/.config/opencode*": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "ask",
      "~/.config/opencode/**": "deny",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "yarn.lock": "deny",
      "Gemfile.lock": "deny",
      "poetry.lock": "deny",
      "Cargo.lock": "deny",
      "*.pem": "deny",
      "*/*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "*/*.key": "deny",
      "**/*.key": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    }
  },
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "timeout": 900000,
        "chunkTimeout": 180000
      },
      "models": {
        "minimax-m3": {
          "name": "MiniMax M3",
          "options": {
            "temperature": 0.3,
            "top_p": 0.95
          }
        },
        "gpt-5-nano": {
          "name": "GPT-5 Nano",
          "options": {
            "temperature": 0.2
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "options": {
            "temperature": 0.2
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash",
          "options": {
            "temperature": 0.5
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "options": {
            "temperature": 0.3,
            "top_p": 0.9
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "options": {
            "temperature": 0.2,
            "top_p": 0.9
          }
        },
        "kimi-k3": {
          "name": "Kimi K3",
          "options": {
            "temperature": 1,
            "top_p": 0.9
          }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "options": {
            "temperature": 0.2,
            "top_p": 0.9
          }
        }
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "minimax-m3": {
          "name": "MiniMax M3 (Go)",
          "options": {
            "temperature": 0.3,
            "top_p": 0.95
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max (Go)",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus (Go)",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (Go)",
          "options": {
            "temperature": 0.3,
            "top_p": 0.9
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Go)",
          "options": {
            "temperature": 0.2,
            "top_p": 0.9
          }
        },
        "kimi-k3": {
          "name": "Kimi K3 (Go)",
          "options": {
            "temperature": 1,
            "top_p": 0.9
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (Go)",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        }
      }
    },
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo",
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "minimax/minimax-m3": {
          "name": "MiniMax M3 (Kilo)",
          "options": {
            "temperature": 0.3,
            "top_p": 0.95
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "openai/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (OpenRouter)",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        }
      }
    }
  },
  "mcp": {
    "mcpjungle": {
      "type": "remote",
      "url": "https://mcpjungle.roborew.xyz/mcp?mode=lazy",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MCPJUNGLE_OPENCODE_TOKEN}"
      }
    },
    "claude-context": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "@zilliz/claude-context-mcp@latest"
      ]
    }
  },
  "agent": {
    "architect": {
      "model": "opencode/glm-5.2",
      "steps": 30
    },
    "architecture-auditor": {
      "mode": "subagent",
      "model": "opencode/glm-5.2",
      "steps": 25
    },
    "orchestrate": {
      "model": "kilo/minimax/minimax-m3",
      "steps": 50
    },
    "plan": {
      "model": "opencode-go/qwen3.7-plus",
      "steps": 20
    },
    "strategist": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "steps": 12
    },
    "build": {
      "model": "opencode/deepseek-v4-flash",
      "steps": 30
    },
    "developer": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash",
      "steps": 30
    },
    "senior-dev": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k3",
      "steps": 40
    },
    "vision": {
      "mode": "subagent",
      "model": "opencode/gemini-3-flash",
      "steps": 5
    },
    "designer": {
      "mode": "subagent",
      "model": "opencode/gemini-3-flash",
      "steps": 10
    },
    "ux-dev": {
      "mode": "subagent",
      "model": "opencode/gemini-3-flash",
      "steps": 30
    },
    "helper": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash",
      "steps": 15
    },
    "debugger": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "steps": 15
    },
    "scribe": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "steps": 5
    },
    "stack-bootstrap": {
      "mode": "subagent",
      "model": "opencode/gpt-5-nano",
      "steps": 15
    },
    "worktree-env": {
      "mode": "subagent",
      "model": "opencode/gpt-5-nano",
      "steps": 10
    },
    "preflight": {
      "mode": "subagent",
      "model": "opencode/gpt-5-nano",
      "steps": 15
    },
    "verifier": {
      "mode": "subagent",
      "model": "kilo/minimax/minimax-m3",
      "steps": 35
    },
    "review": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash",
      "steps": 25
    },
    "security-reviewer": {
      "mode": "subagent",
      "model": "opencode-go/gpt-5.6-luna",
      "steps": 15
    },
    "performance-reviewer": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash",
      "steps": 15
    },
    "doc-reviewer": {
      "mode": "subagent",
      "model": "opencode/gpt-5-nano",
      "steps": 10
    },
    "document": {
      "mode": "subagent",
      "model": "opencode/gpt-5-nano",
      "steps": 10
    },
    "mentor": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-max",
      "steps": 10
    },
    "refactor": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash",
      "steps": 15
    },
    "frontend-dev": {
      "mode": "subagent",
      "model": "kilo/minimax/minimax-m3",
      "steps": 30
    },
    "kilo-fallback": {
      "mode": "subagent",
      "model": "kilo/minimax/minimax-m3",
      "steps": 25
    },
    "openrouter-fallback": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.6-luna",
      "steps": 25
    }
  }
}
