{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "model": "openrouter/minimax/minimax-m2.5",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": { "*": "allow" },
    "external_directory": "allow",
    "doom_loop": "deny"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B"
        }
      }
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "timeout": 300000
      },
      "models": {
        "minimax/minimax-m2.5": {
          "name": "MiniMax M2.5"
        },
        "openai/gpt-5.3-codex": {
          "name": "GPT-5.3-Codex"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        },
        "z-ai/glm-4.7": {
          "name": "GLM 4.7"
        },
        "inception/mercury-2": {
          "name": "Mercury 2"
        }
      }
    }
  },
  "mcp": {
    "augment-context-engine": {
      "type": "local",
      "command": ["/opt/homebrew/bin/auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": true
    },
    "auggie": {
      "type": "remote",
      "url": "https://api.augmentcode.com/mcp",
      "enabled": true
    },
    "docs-mcp-server": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/sse",
      "enabled": true
    },
    "dash-api": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "enabled": true
    }
  },
  "agent": {
    "plan": {
      "model": "openrouter/openai/gpt-5.3-codex"
    },
    "architect": {
      "description": "High-level planner for serious features and refactors. Plans only, delegates scribe to persist .plan artifact, then hands off to orchestrator.",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.3-codex",
      "prompt": "{file:~/.config/opencode/skills/architect/SKILL.md}",
      "tools": { "write": false, "edit": false, "bash": true, "skill": true },
      "permission": {
        "edit": "deny",
        "skill": { "*": "allow" },
        "task": {
          "*": "deny",
          "debugger": "allow",
          "refactor": "allow",
          "review": "allow",
          "designer": "allow",
          "scribe": "allow",
          "orchestrator": "allow"
        }
      }
    },
    "orchestrator": {
      "description": "Execution orchestrator for artifact-driven stage flow",
      "mode": "primary",
      "model": "openrouter/inception/mercury-2",
      "prompt": "{file:~/.config/opencode/skills/orchestrator/SKILL.md}",
      "tools": { "write": false, "edit": false, "bash": false },
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "scribe": "allow",
          "implementor": "allow",
          "designer": "allow",
          "verifier": "allow",
          "helper": "allow"
        }
      }
    },
    "build": {
      "model": "openrouter/openai/gpt-5.3-codex"
    },
    "implementor": {
      "description": "Unified executor for .plan artifacts. Execute only stages with Owner: implementor.",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/implementor/SKILL.md}",
      "steps": 20
    },
    "verifier": {
      "description": "Evidence-driven acceptance verifier",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/verifier/SKILL.md}"
    },
    "debugger": {
      "description": "Planning specialist for debugger-style plans",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/debugger/SKILL.md}",
      "tools": { "write": false, "edit": false, "bash": true },
      "permission": {
        "edit": "deny"
      }
    },
    "refactor": {
      "description": "Planning specialist for refactor plans",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/refactor/SKILL.md}",
      "tools": { "write": false, "edit": false, "bash": true },
      "permission": {
        "edit": "deny"
      }
    },
    "review": {
      "description": "Planning specialist for review plans",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/review/SKILL.md}",
      "tools": { "write": false, "edit": false, "bash": true },
      "permission": {
        "edit": "deny"
      }
    },
    "scribe": {
      "description": "Markdown artifact and docs writer",
      "mode": "subagent",
      "model": "openrouter/inception/mercury-2",
      "prompt": "{file:~/.config/opencode/skills/scribe/SKILL.md}",
      "steps": 5,
      "tools": { "write": true, "edit": true, "bash": false },
      "permission": {
        "edit": {
          "*": "deny",
          ".plan/*.md": "allow",
          ".plan/**/*.md": "allow",
          "*/.plan/*.md": "allow",
          "*/.plan/**/*.md": "allow",
          "docs/changelog/*.md": "allow",
          "docs/changelog/**/*.md": "allow",
          "docs/guides/*.md": "allow",
          "docs/guides/**/*.md": "allow",
          "docs/architecture/*.md": "allow",
          "docs/architecture/**/*.md": "allow",
          "*/docs/changelog/*.md": "allow",
          "*/docs/changelog/**/*.md": "allow",
          "*/docs/guides/*.md": "allow",
          "*/docs/guides/**/*.md": "allow",
          "*/docs/architecture/*.md": "allow",
          "*/docs/architecture/**/*.md": "allow"
        }
      }
    },
    "helper": {
      "description": "Recovery replanner for blocked or failed stages",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/helper/SKILL.md}",
      "tools": { "write": false, "edit": false, "bash": true },
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "scribe": "allow"
        }
      }
    },
    "designer": {
      "description": "UI specialist",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/designer/SKILL.md}"
    },
    "mentor": {
      "description": "Teaching overlay",
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "prompt": "{file:~/.config/opencode/skills/mentor/SKILL.md}"
    }
  }
}
