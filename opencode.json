{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B"
        }
      }
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "timeout": 300000
      },
      "models": {
        "minimax/minimax-m2.7": {
          "name": "MiniMax M2.7"
        },
        "openai/gpt-5.3-codex": {
          "name": "GPT-5.3-Codex"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        },
        "qwen/qwen3.5-plus-02-15": {
          "name": "Qwen3.5 Plus"
        },
        "z-ai/glm-4.7": {
          "name": "GLM 4.7"
        },
        "stepfun/step-3.5-flash:free": {
          "name": "Stepfun Step 3.5 Flash (Free)"
        },
        "qwen/qwen3-vl-235b-a22b-instruct": {
          "name": "Qwen3 VL 235B (vision)"
        },
        "google/gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview"
        },
        "xiaomi/mimo-v2-pro": {
          "name": "Xiaomi Mimo V2 Pro"
        },
        "deepseek/deepseek-v3.2": {
          "name": "DeepSeek V3.2"
        }
      }
    }
  },
  "mcp": {
    "augment-context-engine": {
      "type": "local",
      "command": ["/opt/homebrew/bin/auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": false
    },
    "auggie": {
      "type": "remote",
      "url": "https://api.augmentcode.com/mcp",
      "enabled": false
    },
    "docs-mcp-server": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/sse",
      "enabled": true
    },
    "dash-api": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "claude-context": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@zilliz/claude-context-mcp@latest"]
    }
  },
  "agent": {
    "architect": {
      "model": "openrouter/xiaomi/mimo-v2-pro"
    },
    "orchestrate": {
      "model": "openrouter/qwen/qwen3.5-plus-02-15"
    },
    "plan": {
      "model": "openrouter/openai/gpt-5.3-codex"
    },
    "build": {
      "model": "openrouter/openai/gpt-5.3-codex"
    },
    "developer": {
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.7",
      "steps": 60
    },
    "senior-dev": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.3-codex",
      "steps": 60
    },
    "vision": {
      "mode": "subagent",
      "model": "openrouter/qwen/qwen3-vl-235b-a22b-instruct"
    },
    "designer": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3.1-pro-preview"
    },
    "ux-dev": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3.1-pro-preview"
    },
    "helper": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2"
    }
  }
}
