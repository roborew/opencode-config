{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "instructions": ["rules/testing.md", "rules/**/*.md"],
  "permission": {
    "edit": {
      "opencode.json": "deny",
      "package-lock.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      ".env": "deny",
      ".env.*": "deny"
    }
  },
  "provider": {
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "timeout": 300000,
        "chunkTimeout": 60000
      },
      "models": {
        "minimax/minimax-m2.7": {
          "name": "MiniMax M2.7",
          "options": {
            "temperature": 0.3,
            "top_p": 0.95
          }
        },
        "minimax/minimax-m2.7:nitro": {
          "name": "MiniMax M2.7 (nitro)",
          "options": {
            "temperature": 0.3,
            "top_p": 0.95
          }
        },
        "openai/gpt-5.3-codex": {
          "name": "GPT-5.3-Codex",
          "options": {
            "temperature": 0.3
          }
        },
        "openai/gpt-5-nano": {
          "name": "GPT-5 Nano",
          "options": {
            "temperature": 0.2
          }
        },
        "qwen/qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "options": {
            "temperature": 0.4,
            "top_p": 0.95
          }
        },
        "qwen/qwen3.6-plus:nitro": {
          "name": "Qwen3.6 Plus (nitro)",
          "options": {
            "temperature": 0.4,
            "top_p": 0.95
          }
        },
        "qwen/qwen3-next-80b-a3b-instruct": {
          "name": "Qwen3 Next 80B A3B Instruct",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        },
        "qwen/qwen3-vl-235b-a22b-instruct": {
          "name": "Qwen3 VL 235B (vision)",
          "options": {
            "temperature": 0.2
          }
        },
        "google/gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview",
          "options": {
            "temperature": 0.5
          }
        },
        "deepseek/deepseek-v3.2": {
          "name": "DeepSeek V3.2",
          "options": {
            "temperature": 0.3,
            "top_p": 0.9,
            "frequency_penalty": 0.3
          }
        }
      }
    }
  },
  "mcp": {
    "augment-context-engine": {
      "type": "local",
      "command": ["/opt/homebrew/bin/auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": false
    },
    "auggie": {
      "type": "remote",
      "url": "https://api.augmentcode.com/mcp",
      "enabled": false
    },
    "docs-mcp-server": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/sse",
      "enabled": true
    },
    "dash-api": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "claude-context": {
      "type": "local",
      "enabled": true,
      "command": [
        "/Users/robo/.local/share/mise/installs/node/22.22.1/bin/npx",
        "-y",
        "@zilliz/claude-context-mcp@latest"
      ]
    }
  },
  "agent": {
    "architect": {
      "model": "openrouter/qwen/qwen3.6-plus",
      "steps": 30
    },
    "orchestrate": {
      "model": "openrouter/qwen/qwen3.6-plus",
      "steps": 50
    },
    "plan": {
      "model": "openrouter/qwen/qwen3.6-plus"
    },
    "strategist": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 15
    },
    "build": {
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 30
    },
    "developer": {
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.7",
      "steps": 45
    },
    "senior-dev": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.3-codex",
      "steps": 40
    },
    "vision": {
      "mode": "subagent",
      "model": "openrouter/qwen/qwen3-vl-235b-a22b-instruct",
      "steps": 5
    },
    "designer": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3-flash-preview",
      "steps": 10
    },
    "ux-dev": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3-flash-preview",
      "steps": 30
    },
    "helper": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 15
    },
    "debugger": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 15
    },
    "scribe": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 5
    },
    "worktree-env": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 10
    },
    "verifier": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 10
    },
    "review": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 15
    },
    "security-reviewer": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 15
    },
    "performance-reviewer": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 15
    },
    "doc-reviewer": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 10
    },
    "document": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 10
    },
    "mentor": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 10
    },
    "refactor": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "steps": 15
    },
    "frontend-dev": {
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.7",
      "steps": 45
    }
  }
}
