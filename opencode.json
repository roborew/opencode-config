{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/minimax/minimax-m2.5",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B"
        }
      }
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "models": {
        "minimax/minimax-m2.5": {
          "name": "MiniMax M2.5"
        },
        "openai/gpt-5.3-codex": {
          "name": "GPT-5.3-Codex"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        },
        "z-ai/glm-4.7": {
          "name": "GLM 4.7"
        }
      }
    }
  },
  "mcp": {
    "augment-context-engine": {
      "type": "local",
      "command": ["/opt/homebrew/bin/auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": true
    },
    "auggie": {
      "type": "remote",
      "url": "https://api.augmentcode.com/mcp",
      "enabled": true
    },
    "docs-mcp-server": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/sse",
      "enabled": true
    },
    "dash-api": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "enabled": true
    }
  },
  "agent": {
    "plan": {
      "description": "High-level feature planning agent",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.3-codex",
      "prompt": "{file:./skills/plan/SKILL.md}",
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "build": {
      "description": "Implements feature plans from .plan/plan.*.md",
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-4.7",
      "prompt": "{file:./skills/build/SKILL.md}"
    },
    "implementor": {
      "description": "Scoped leaf executor for implementation tasks",
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-4.7",
      "prompt": "{file:./skills/implementor/SKILL.md}"
    },
    "fix": {
      "description": "Implements bugfix steps from .plan/debug.*.md",
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-4.7",
      "prompt": "{file:./skills/implementor/SKILL.md}"
    },
    "verifier": {
      "description": "Evidence-driven acceptance verifier",
      "mode": "subagent",
      "prompt": "{file:./skills/verifier/SKILL.md}"
    },
    "debugger": {
      "description": "Diagnose-first bug orchestrator",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.3-codex",
      "prompt": "{file:./skills/debugger/SKILL.md}",
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "refactorer": {
      "description": "Behavior-preserving refactor orchestrator",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.3-codex",
      "prompt": "{file:./skills/refactorer/SKILL.md}",
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "review": {
      "description": "High-signal PR review planner",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.3-codex",
      "prompt": "{file:./skills/pr-reviewer/SKILL.md}",
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "pr-reviewer": {
      "description": "Applies changes from .plan/review.*.md",
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-4.7",
      "prompt": "{file:./skills/implementor/SKILL.md}"
    },
    "ui-designer": {
      "description": "UI specialist",
      "mode": "subagent",
      "prompt": "{file:./skills/ui-designer/SKILL.md}"
    },
    "mentor": {
      "description": "Teaching overlay",
      "mode": "subagent",
      "prompt": "{file:./skills/mentor/SKILL.md}"
    }
  }
}
