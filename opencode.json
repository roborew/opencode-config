{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "instructions": ["rules/testing.md", "rules/**/*.md"],
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf ~": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git clean -f *": "deny",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "git branch -m *": "deny",
      "git branch -M *": "deny",
      "git branch [!-]*": "deny",
      "git checkout .": "deny",
      "git restore .": "deny",
      "git switch *": "deny",
      "git checkout develop": "deny",
      "git checkout main": "deny",
      "git checkout master": "deny",
      "git checkout -b *": "deny",
      "git checkout -B *": "deny",
      "git switch -c *": "deny",
      "git switch -C *": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "ask",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "yarn.lock": "deny",
      "Gemfile.lock": "deny",
      "poetry.lock": "deny",
      "Cargo.lock": "deny",
      "*.pem": "deny",
      "*/*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "*/*.key": "deny",
      "**/*.key": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    }
  },
  "provider": {
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "timeout": 300000,
        "chunkTimeout": 60000
      },
      "models": {
        "minimax/minimax-m3": {
          "name": "MiniMax M3",
          "options": {
            "temperature": 0.3,
            "top_p": 0.95
          }
        },
        "openai/gpt-5-nano": {
          "name": "GPT-5 Nano",
          "options": {
            "temperature": 0.2
          }
        },
        "openai/gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "options": {
            "temperature": 0.2
          }
        },
        "qwen/qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "temperature": 0.1,
            "top_p": 0.9
          }
        },
        "qwen/qwen3-vl-235b-a22b-instruct": {
          "name": "Qwen3 VL 235B (vision)",
          "options": {
            "temperature": 0.2
          }
        },
        "google/gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview",
          "options": {
            "temperature": 0.5
          }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "options": {
            "temperature": 0.3,
            "top_p": 0.9,
            "frequency_penalty": 0.3,
            "provider": {
              "order": [
                "fireworks",
                "venice",
                "digitalocean",
                "morph"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "options": {
            "temperature": 0.2,
            "top_p": 0.9
          }
        },
        "anthropic/claude-opus-4.8": {
          "name": "Claude Opus 4.8"
        }
      }
    }
  },
  "mcp": {
    "augment-context-engine": {
      "type": "local",
      "command": ["/opt/homebrew/bin/auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": false
    },
    "auggie": {
      "type": "remote",
      "url": "https://api.augmentcode.com/mcp",
      "enabled": false
    },
    "docs-mcp-server": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/sse",
      "enabled": true
    },
    "dash-api": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "claude-context": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "@zilliz/claude-context-mcp@latest"
      ]
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "agent": {
    "architect": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 30
    },
    "architecture-auditor": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.6-terra",
      "steps": 35
    },
    "orchestrate": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 100
    },
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 20
    },
    "strategist": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "steps": 12
    },
    "build": {
      "model": "openrouter/minimax/minimax-m3",
      "steps": 30
    },
    "developer": {
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m3",
      "steps": 45
    },
    "senior-dev": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.6-terra",
      "steps": 40
    },
    "vision": {
      "mode": "subagent",
      "model": "openrouter/qwen/qwen3-vl-235b-a22b-instruct",
      "steps": 5
    },
    "designer": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3-flash-preview",
      "steps": 10
    },
    "ux-dev": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3-flash-preview",
      "steps": 30
    },
    "helper": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 15
    },
    "debugger": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 15
    },
    "scribe": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 5
    },
    "stack-bootstrap": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 15
    },
    "worktree-env": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 10
    },
    "preflight": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 15
    },
    "verifier": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 10
    },
    "review": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 15
    },
    "security-reviewer": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-opus-4.8",
      "steps": 15
    },
    "performance-reviewer": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 15
    },
    "doc-reviewer": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 10
    },
    "document": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5-nano",
      "steps": 10
    },
    "mentor": {
      "mode": "subagent",
      "model": "openrouter/qwen/qwen3.7-max",
      "steps": 10
    },
    "refactor": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "steps": 15
    },
    "frontend-dev": {
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m3",
      "steps": 45
    }
  }
}
