{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B"
        }
      }
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "timeout": 300000
      },
      "models": {
        "minimax/minimax-m2.5": {
          "name": "MiniMax M2.5"
        },
        "openai/gpt-5.3-codex": {
          "name": "GPT-5.3-Codex"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        },
        "qwen/qwen3.5-plus-02-15": {
          "name": "Qwen3.5 Plus"
        },
        "z-ai/glm-4.7": {
          "name": "GLM 4.7"
        },
        "inception/mercury-2": {
          "name": "Mercury 2"
        }
      }
    }
  },
  "mcp": {
    "augment-context-engine": {
      "type": "local",
      "command": ["/opt/homebrew/bin/auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": true
    },
    "auggie": {
      "type": "remote",
      "url": "https://api.augmentcode.com/mcp",
      "enabled": true
    },
    "docs-mcp-server": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/sse",
      "enabled": true
    },
    "dash-api": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "enabled": true
    }
  },
  "agent": {
    "architect": {
      "model": "openrouter/openai/gpt-5.3-codex"
    },
    "orchestrate": {
      "model": "openrouter/qwen/qwen3.5-plus-02-15"
    },
    "plan": {
      "model": "openrouter/openai/gpt-5.3-codex"
    },
    "build": {
      "model": "openrouter/openai/gpt-5.3-codex"
    },
    "developer": {
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.5",
      "steps": 60
    }
  }
}
