#!/usr/bin/env bash
# Sync PRD → GitHub issue bodies and validate feature:<slug> tickets (all repos in PRD).
# Run from spec repo root after editing docs/prd/<slug>.md
#
# Usage: bin/feature-upgrade <slug> [--skip-sync-tooling]
set -euo pipefail
SLUG="${1:?slug required}"
shift || true
SKIP_TOOLING=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-sync-tooling) SKIP_TOOLING=true; shift ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN_DIR/.." && pwd)"
OC="${OPENCODE_CONFIG:-$HOME/.config/opencode}"

echo "==> feature-upgrade: ${SLUG}"
echo "    spec repo: ${ROOT}"

if [[ "$SKIP_TOOLING" != "true" && -x "${OC}/bin/stack/sync_spec_tooling.sh" ]]; then
  echo "==> Syncing spec tooling from OpenCode templates..."
  "${OC}/bin/stack/sync_spec_tooling.sh" "$ROOT" || true
fi

echo "==> Syncing issue bodies from PRD (preserves filled issue-expand content)..."
"${BIN_DIR}/sync-fanout-bodies" "$SLUG"

echo ""
echo "==> Checking fanout structure (all repos)..."
FANOUT_OK=true
"${BIN_DIR}/feature-check" "$SLUG" --level fanout || FANOUT_OK=false

echo ""
echo "==> Checking orchestrate readiness (all repos)..."
ORCH_OK=true
"${BIN_DIR}/feature-check" "$SLUG" --level orchestrate || ORCH_OK=false

IMPL_REPOS=$(python3 "${BIN_DIR}/lib/prd_io.py" tickets_json "${ROOT}/docs/prd/${SLUG}.md" | jq -r '.[].repo' | sort -u)

echo ""
echo "Next steps (OpenCode — not shell)"
for repo in $IMPL_REPOS; do
  echo "  ${repo}: open repo in OpenCode → architect → option 1 → slug ${SLUG} (issue-expand)"
done

echo ""
if [[ "$FANOUT_OK" == "true" && "$ORCH_OK" == "true" ]]; then
  echo "STATUS: PASS — ready for orchestrate on all repos."
  exit 0
fi
if [[ "$FANOUT_OK" == "true" ]]; then
  echo "STATUS: fanout structure OK; run issue-expand in impl repos (see above)."
  exit 0
fi
echo "STATUS: INCOMPLETE — fix fanout/feature-check errors, re-run bin/feature-upgrade ${SLUG}"
exit 1
